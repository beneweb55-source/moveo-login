# ============================================================
# MOVEO — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit real secrets to version control.
# ============================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# NEXT_PUBLIC_TMDB_API_KEY: Required for fetching data from TMDB API.
NEXT_PUBLIC_TMDB_API_KEY="your_tmdb_api_key_here"

# DATABASE_URL: Connection string for NeonDB PostgreSQL (Main App)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# SCRAPER_DATABASE_URL: Connection string for the Scraper's Database (Catalogue)
SCRAPER_DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# JWT_SECRET: Secret key for signing JWT tokens (use a long random string)
JWT_SECRET="your_super_secret_jwt_key_here"

# GOOGLE_CLIENT_ID: Google OAuth Client ID
GOOGLE_CLIENT_ID="your_google_client_id_here"

# GOOGLE_CLIENT_SECRET: Google OAuth Client Secret
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# AUTH_URL: The URL for NextAuth v5
AUTH_URL="https://your-domain.vercel.app/api/auth"

# NEXTAUTH_URL: The URL for NextAuth compatibility
NEXTAUTH_URL="https://your-domain.vercel.app"

# AUTH_TRUST_HOST: Trust host for NextAuth
AUTH_TRUST_HOST="true"

# NEXT_PUBLIC_CONSUMET_API_URL: URL of your deployed Consumet API instance
NEXT_PUBLIC_CONSUMET_API_URL="https://your-consumet-api.onrender.com"

# RESEND_API_KEY: Resend API key for sending emails
RESEND_API_KEY="your_resend_api_key_here"

# HCAPTCHA_SITEKEY: Public key for hCaptcha
NEXT_PUBLIC_HCAPTCHA_SITEKEY="your_hcaptcha_sitekey_here"

# HCAPTCHA_SECRET: Secret key for hCaptcha verification
HCAPTCHA_SECRET="your_hcaptcha_secret_here"

# FOUNDER_EMAIL: Email of the founder account (receives full admin permissions)
FOUNDER_EMAIL="your_founder_email@example.com"
